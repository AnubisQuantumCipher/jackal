# Build artifact — regenerated from jackal_calc.anb via the pinned Anubis
# compiler (see the launcher and README). The SHA-256 of the exact gate-tested
# binary is sealed in PROVENANCE.md rather than tracked here, so history
# stays lean. (Transpile is byte-deterministic; the rustc link is not yet —
# see PROVENANCE.md "Build determinism".)
jackal-native

# Ephemeral run/verify logs
*.log

# Anubis scratch build dirs
/tmp/
*.tmp
.build/
# Compiler out-dir when JACKAL_OUT (or `anubis check`) is pointed at the repo
# root: `anubis_run` (Mach-O), the generated `anubis_run.rs`, and the
# `<name>.{ast,hir,mir,mono}.json` diagnostic sidecars. All regenerated by
# `JACKAL_FORCE_SOURCE=1 JACKAL_OUT=<dir> ./jackal ...` or `anubis check`.
# Nothing in the repo reads this tree and no digest pins it; sealed evidence
# lives under release/evidence/ and release/MANIFEST.sha256 instead.
/out/


# Python bytecode from the test harness
tests/__pycache__/

# Lean build artifacts (Mathlib cache is multi-GB)
proofs/lean/.lake/

# built release package (shipped as a release asset, not committed)
release/dist/
__pycache__/
