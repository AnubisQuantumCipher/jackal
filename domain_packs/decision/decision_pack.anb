// JACKAL deterministic decision domain pack v1.
//
// This module owns only the closed routing decision for decision-matrix claims.
//
// What this pack does: given a caller-declared numeric criterion and a set of
// labelled integer scores, it selects the argmax or argmin and records the
// margin to the runner-up. Every step is recomputable from the certificate.
//
// What this pack refuses to do, permanently: rank options on preference,
// goodness, or worth. A decision matrix can order options by a stated,
// recomputable numeric criterion. It cannot establish that the criterion is the
// right one to optimise, and it cannot turn a value judgment into a
// mathematical fact. Requests whose criterion names a value judgment are
// refused with `decision-value-judgment` rather than answered.
//
// Consequence class is `decision-boundary`: the output is intended to inform a
// decision, and the caller's declared criterion remains the caller's.

pub fn protocol_version() {
    return "1";
}

pub fn pack_id() {
    return "jackal.decision.matrix";
}

pub fn route_operation(requested_pack, operation_id, argument_count) {
    if requested_pack != pack_id() {
        panic("pack-id-unknown: requested pack is not registered; fail closed");
    }
    if operation_id == "decision.matrix.rank.v1" {
        // decision_id, criterion, sense, then 2..6 label/value pairs.
        if argument_count < 7 {
            panic("pack-request-arity: decision.matrix.rank.v1 requires at least 7 arguments (id, criterion, sense, and two label/value pairs); fail closed");
        }
        if argument_count > 15 {
            panic("pack-request-arity: decision.matrix.rank.v1 accepts at most 6 options; fail closed");
        }
        if (argument_count - 3) % 2 != 0 {
            panic("pack-request-arity: decision.matrix.rank.v1 requires label/value pairs; fail closed");
        }
        return "decision-rank";
    }
    panic("pack-operation-unknown: no fallback is permitted; fail closed");
}
