#!/bin/sh
# JACKAL v1.7.2 sqrt_rat fail-closed release wrapper.
#
# Admits ONLY `sqrt(x)` on a canonical rational interval [lo, hi] and emits
# a request-bound release ACCEPT from the pinned Lean-proved checker.
# The producer and checker binaries are pinned to their release/MANIFEST.sha256
# SHA-256 values; identities are hashed before AND after invocation (TOCTOU
# stable) exactly like every other formal lane. Any drift refuses fail-closed
# with a stable class, never a bounded fallback.
#
# When a fourth argument is supplied, the wrapper writes a canonical
# `jackal-formal-receipt-v1` JSON receipt (variant=sqrt_rat) that can be
# independently re-checked by `jackal-receipt-verify`.
#
# Usage:
#   jackal-sqrt-rat-release "sqrt(x)" <lo> <hi>
#   jackal-sqrt-rat-release "sqrt(x)" <lo> <hi> <formal-receipt.json>
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PRODUCER="$ROOT/tools/sqrt_rat_producer.py"
CHECKER="$ROOT/proofs/lean/.lake/build/bin/jackal_cert_check"
MANIFEST="$ROOT/release/MANIFEST.sha256"
PROOF_ID="$ROOT/release/evidence/range_proof_identity_v172.json"
INVENTORY="$ROOT/release/coverage/formal_coverage_inventory.json"

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
    echo "usage: jackal-sqrt-rat-release \"sqrt(x)\" <lo> <hi> [formal-receipt.json]" >&2
    exit 2
fi
EXPR="$1"; LO="$2"; HI="$3"; RECEIPT_OUT="${4:-}"

if [ ! -f "$MANIFEST" ]; then
    echo "status=unavailable reason=manifest-missing path=$MANIFEST" >&2
    exit 3
fi
if [ ! -x "$CHECKER" ]; then
    echo "status=unavailable reason=checker-missing path=$CHECKER" >&2
    exit 3
fi
if [ ! -f "$PRODUCER" ]; then
    echo "status=unavailable reason=producer-missing path=$PRODUCER" >&2
    exit 3
fi

EXPECTED_PROD=$(awk '$1=="sqrt_rat_producer" {print $NF}' "$MANIFEST")
EXPECTED_CHK=$(awk '$1=="checker" {print $NF}' "$MANIFEST")
if [ -z "$EXPECTED_PROD" ] || [ -z "$EXPECTED_CHK" ]; then
    echo "status=unavailable reason=manifest-incomplete detail=\"missing sqrt_rat_producer or checker pin\"" >&2
    exit 3
fi

PROD_PRE=$(shasum -a 256 "$PRODUCER" | awk '{print $1}')
CHK_PRE=$(shasum -a 256 "$CHECKER" | awk '{print $1}')
if [ "$PROD_PRE" != "$EXPECTED_PROD" ]; then
    echo "status=refused reason=producer-identity detail=\"$PROD_PRE != pinned $EXPECTED_PROD\"" >&2
    exit 1
fi
if [ "$CHK_PRE" != "$EXPECTED_CHK" ]; then
    echo "status=refused reason=checker-identity detail=\"$CHK_PRE != pinned $EXPECTED_CHK\"" >&2
    exit 1
fi

TMPD=$(mktemp -d)
trap 'rm -rf "$TMPD"' EXIT
CERT="$TMPD/sqrt.cert"

if ! python3 -I -S -B "$PRODUCER" emit --expression "$EXPR" --lower "$LO" --upper "$HI" > "$CERT" 2>&1; then
    err=$(cat "$CERT" 2>/dev/null | head -1 || true)
    echo "status=refused reason=producer-refused detail=\"${err#REFUSE }\"" >&2
    exit 1
fi

PROD_POST=$(shasum -a 256 "$PRODUCER" | awk '{print $1}')
if [ "$PROD_POST" != "$PROD_PRE" ]; then
    echo "status=refused reason=producer-toctou detail=\"producer bytes changed across call\"" >&2
    exit 1
fi

OUT=$("$CHECKER" "$CERT" range-bound-cert "$EXPR" "$LO" "$HI" 2>&1) || {
    echo "status=refused reason=checker-rejected detail=\"$OUT\"" >&2
    exit 1
}

CHK_POST=$(shasum -a 256 "$CHECKER" | awk '{print $1}')
if [ "$CHK_POST" != "$CHK_PRE" ]; then
    echo "status=refused reason=checker-toctou detail=\"checker bytes changed across call\"" >&2
    exit 1
fi

if [ -n "$RECEIPT_OUT" ]; then
    EXPECTED_PROOF=$(awk '$1=="range-proof-identity" {print $NF}' "$MANIFEST")
    EXPECTED_INV=$(awk '$1=="coverage-inventory" {print $NF}' "$MANIFEST")
    PROOF_PRE=$(shasum -a 256 "$PROOF_ID" | awk '{print $1}')
    INV_PRE=$(shasum -a 256 "$INVENTORY" | awk '{print $1}')
    MANIFEST_PRE=$(shasum -a 256 "$MANIFEST" | awk '{print $1}')
    [ "$PROOF_PRE" = "$EXPECTED_PROOF" ] && [ "$INV_PRE" = "$EXPECTED_INV" ] || {
        echo "status=refused reason=receipt-authority-identity" >&2
        exit 1
    }
    python3 -I -S -B "$ROOT/tools/isolated_entry.py" emit-variant-receipt \
      --variant sqrt_rat --expression "$EXPR" --lower "$LO" --upper "$HI" \
      --cert "$CERT" --producer "$PRODUCER" --checker "$CHECKER" \
      --proof-identity "$PROOF_ID" --inventory "$INVENTORY" \
      --release-epoch v1.7.2 --output "$RECEIPT_OUT"
    [ "$(shasum -a 256 "$PROOF_ID" | awk '{print $1}')" = "$PROOF_PRE" ] && \
    [ "$(shasum -a 256 "$INVENTORY" | awk '{print $1}')" = "$INV_PRE" ] && \
    [ "$(shasum -a 256 "$MANIFEST" | awk '{print $1}')" = "$MANIFEST_PRE" ] || {
        echo "status=refused reason=receipt-authority-toctou" >&2
        exit 1
    }
    echo "receipt=$RECEIPT_OUT"
fi

[ "$(shasum -a 256 "$PRODUCER" | awk '{print $1}')" = "$PROD_PRE" ] && \
[ "$(shasum -a 256 "$CHECKER" | awk '{print $1}')" = "$CHK_PRE" ] || {
    echo "status=refused reason=runtime-toctou" >&2
    exit 1
}
echo "status=formal-bounded"
echo "cert-status=bounded"
echo "assurance=proof-carrying-certificate(checker-accepted;sqrtRat-Runs-derivation;NO-libm-TCB)"
echo "checker.ACCEPT=$OUT"
echo "checker.sha256=$CHK_PRE"
echo "producer.sha256=$PROD_PRE"
