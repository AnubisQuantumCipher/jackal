#!/bin/sh
# JACKAL v1.5.0 tanh_rat fail-closed release wrapper.
#
# Admits ONLY the exact composite expression `1-2/(exp(2*x)+1)`
# (= tanh(x) mathematically; `tanh` is NOT a grammar token) on a canonical
# rational interval [lo, hi] with |lo|, |hi| <= 20 and emits a request-bound
# release ACCEPT from the pinned Lean-proved checker.
# The producer and checker binaries are pinned to their release/MANIFEST.sha256
# SHA-256 values; identities are hashed before AND after invocation (TOCTOU
# stable) exactly like every other formal lane. Any drift refuses fail-closed
# with a stable class, never a bounded fallback.
#
# When a fourth argument is supplied, the wrapper writes a canonical
# `jackal-formal-receipt-v1` JSON receipt (variant=tanh_rat) that can be
# independently re-checked by `jackal-receipt-verify`.
#
# Usage:
#   jackal-tanh-rat-release "1-2/(exp(2*x)+1)" <lo> <hi>
#   jackal-tanh-rat-release "1-2/(exp(2*x)+1)" <lo> <hi> <formal-receipt.json>
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PRODUCER="$ROOT/tools/tanh_rat_producer.py"
CHECKER="$ROOT/proofs/lean/.lake/build/bin/jackal_cert_check"
MANIFEST="$ROOT/release/MANIFEST.sha256"

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
    echo "usage: jackal-tanh-rat-release \"1-2/(exp(2*x)+1)\" <lo> <hi> [formal-receipt.json]" >&2
    exit 2
fi
EXPR="$1"; LO="$2"; HI="$3"; RECEIPT_OUT="${4:-}"

if [ ! -f "$MANIFEST" ]; then
    echo "status=unavailable reason=manifest-missing path=$MANIFEST" >&2
    exit 3
fi
if [ ! -x "$CHECKER" ]; then
    echo "status=unavailable reason=checker-missing path=$CHECKER" >&2
    exit 3
fi
if [ ! -f "$PRODUCER" ]; then
    echo "status=unavailable reason=producer-missing path=$PRODUCER" >&2
    exit 3
fi

EXPECTED_PROD=$(awk '$1=="tanh_rat_producer" {print $NF}' "$MANIFEST")
EXPECTED_CHK=$(awk '$1=="checker" {print $NF}' "$MANIFEST")
if [ -z "$EXPECTED_PROD" ] || [ -z "$EXPECTED_CHK" ]; then
    echo "status=unavailable reason=manifest-incomplete detail=\"missing tanh_rat_producer or checker pin\"" >&2
    exit 3
fi

PROD_PRE=$(shasum -a 256 "$PRODUCER" | awk '{print $1}')
CHK_PRE=$(shasum -a 256 "$CHECKER" | awk '{print $1}')
if [ "$PROD_PRE" != "$EXPECTED_PROD" ]; then
    echo "status=refused reason=producer-identity detail=\"$PROD_PRE != pinned $EXPECTED_PROD\"" >&2
    exit 1
fi
if [ "$CHK_PRE" != "$EXPECTED_CHK" ]; then
    echo "status=refused reason=checker-identity detail=\"$CHK_PRE != pinned $EXPECTED_CHK\"" >&2
    exit 1
fi

TMPD=$(mktemp -d)
trap 'rm -rf "$TMPD"' EXIT
CERT="$TMPD/tanh.cert"

if ! python3 -I -S -B "$PRODUCER" emit --expression "$EXPR" --lower "$LO" --upper "$HI" > "$CERT" 2>&1; then
    err=$(cat "$CERT" 2>/dev/null | head -1 || true)
    echo "status=refused reason=producer-refused detail=\"${err#REFUSE }\"" >&2
    exit 1
fi

PROD_POST=$(shasum -a 256 "$PRODUCER" | awk '{print $1}')
if [ "$PROD_POST" != "$PROD_PRE" ]; then
    echo "status=refused reason=producer-toctou detail=\"producer bytes changed across call\"" >&2
    exit 1
fi

OUT=$("$CHECKER" "$CERT" range-bound-cert "$EXPR" "$LO" "$HI" 2>&1) || {
    echo "status=refused reason=checker-rejected detail=\"$OUT\"" >&2
    exit 1
}

CHK_POST=$(shasum -a 256 "$CHECKER" | awk '{print $1}')
if [ "$CHK_POST" != "$CHK_PRE" ]; then
    echo "status=refused reason=checker-toctou detail=\"checker bytes changed across call\"" >&2
    exit 1
fi

echo "status=formal-bounded"
echo "cert-status=bounded"
echo "assurance=proof-carrying-certificate(checker-accepted;composite-zero-libm-DAG;NO-libm-TCB)"
echo "checker.ACCEPT=$OUT"
echo "checker.sha256=$CHK_PRE"
echo "producer.sha256=$PROD_PRE"

if [ -n "$RECEIPT_OUT" ]; then
    PYTHONPATH="$ROOT/tools" python3 -I -S -B - "$CERT" "$EXPR" "$LO" "$HI" "$RECEIPT_OUT" "$ROOT" <<'PY'
import base64, hashlib, json, sys
from pathlib import Path
cert_path, expr, lo, hi, out_path, root_str = sys.argv[1:7]
root = Path(root_str)
sys.path.insert(0, str(root / "tools"))
import formal_receipt as fr
cert_bytes = Path(cert_path).read_bytes()
producer_sha = hashlib.sha256((root / "tools/tanh_rat_producer.py").read_bytes()).hexdigest()
checker_sha = hashlib.sha256((root / "proofs/lean/.lake/build/bin/jackal_cert_check").read_bytes()).hexdigest()
proof = fr.load_proof_identity_binding(root / "release/evidence/range_proof_identity.json")
inv_bytes = (root / "release/coverage/formal_coverage_inventory.json").read_bytes()
inv_sha = hashlib.sha256(inv_bytes).hexdigest()
receipt = fr.build_variant_formal_receipt(
    variant=fr.TANH_RAT_VARIANT,
    release_epoch="v1.5.0",
    request={"command": "range-bound-cert", "expression": expr,
             "input_lo": lo, "input_hi": hi},
    enclosure=tuple(fr._parse_cert_header(cert_bytes).get("output","").split(" ", 1)),
    cert_bytes=cert_bytes,
    producer_sha256=producer_sha,
    checker_sha256=checker_sha,
    canonical_lo=fr.canonical_rat(lo),
    canonical_hi=fr.canonical_rat(hi),
    request_commitment_b64=fr.request_commitment_b64("range-bound-cert", expr, lo, hi),
    coverage_inventory_sha256=inv_sha,
    proof_identity=proof,
    plugin_sha256=None,
)
Path(out_path).write_text(fr.dump_receipt(receipt))
print(f"receipt={out_path}", file=sys.stderr)
PY
    echo "receipt=$RECEIPT_OUT"
fi
