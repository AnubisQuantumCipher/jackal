#!/bin/sh
# JACKAL Hermes plugin launcher — thin wrapper around server.py so downstream
# hosts see a stable executable name they can pin and invoke.
#
# All arguments pass through unchanged.  See `server.py` for the surface:
#     jackal_hermes stdio                     JSON-RPC 2.0 (MCP transport)
#     jackal_hermes call <tool> <args-json>   one-shot call
#     jackal_hermes http --port 8181          HTTP wrapper
#     jackal_hermes selftest                  bundle-hash + pin diagnostic
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$DIR/../../tools/isolated_entry.py" ]; then
    ENTRY="$DIR/../../tools/isolated_entry.py"
elif [ -f "$DIR/../../isolated_entry.py" ]; then
    ENTRY="$DIR/../../isolated_entry.py"
else
    echo "status=refused reason=isolated-runtime-missing" >&2
    exit 126
fi
exec python3 -I -S -B "$ENTRY" plugin "$@"
