project Jackal_Claim_Policy is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("jackal_claim_policy_vectors.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe", "-O2", "-g");
   end Compiler;
end Jackal_Claim_Policy;
