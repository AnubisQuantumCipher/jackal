project Hellgate_Interval is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("hellgate_interval_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;
end Hellgate_Interval;
